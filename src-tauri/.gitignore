# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Сборочные артефакты вендоренных сайдкар-инструментов (PyInstaller) — не коммитим.
# Сами исходники инструментов (tools/unrpa, tools/unrpyc/*.py, tools/extractor/*.py) — коммитим.
/tools/build/
/tools/dist/
/tools/**/build/
/tools/**/dist/
**/__pycache__/
*.pyc

